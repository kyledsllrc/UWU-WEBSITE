# Public app origin, used to build the Discord OAuth callback URL.
APP_URL="https://your-dashboard.example"

# Discord Developer Portal > OAuth2
DISCORD_CLIENT_ID="your_discord_application_id"
DISCORD_CLIENT_SECRET="your_discord_oauth_client_secret"
# Encrypts the server-side OAuth session cookie. NEXTAUTH_SECRET is accepted as a fallback.
DASHBOARD_SESSION_SECRET="a_long_random_secret_value"
## Optional comma-separated Discord IDs allowed into the admin dashboard.
## Defaults to the bot owner ID configured in the bot repository.
DASHBOARD_ADMIN_USER_IDS="906461875221434428"

# Discord Developer Portal > Bot > Token. This is separate from DISCORD_CLIENT_SECRET.
DISCORD_BOT_TOKEN="your_discord_bot_token"

# Firebase Admin SDK
FIREBASE_PROJECT_ID="your_firebase_project_id"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://your-project-default-rtdb.region.firebasedatabase.app"
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
